PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/requirement_posting
CORS_ORIGIN=http://localhost:3000

# JWT Authentication (REQUIRED - minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Admin Account (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!SecurePassword

# Cloudinary (Optional - for image/file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com

# Frontend URL (for emails and CORS)
CLIENT_URL=http://localhost:3000

# Moderation (Optional)
REQUIRE_APPROVAL=false
